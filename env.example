# One of the two keys. OpenRouter is the default provider.
OPENROUTER_API_KEY=
# TYPESAFE_API_KEY=

# Model id. OpenRouter: typesafe/jev-1.13 (default). TypeSafe native: jev-latest
# JEV_MODEL=typesafe/jev-1.13

# Which emails to run
EMAILS_FILE=emails.jsonl
# EMAILS_FILE=bank_inbound_emails.jsonl

# Policy thresholds on department confidence
AUTO_THRESHOLD=0.90
REVIEW_THRESHOLD=0.75

# Jev list price, USD per million input tokens
JEV_PRICE_PER_M_INPUT=0.042

# PORT=8080
# MOCK=1
